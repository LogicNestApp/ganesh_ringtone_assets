  "quotes": [
    {
      "id": "q_1",
      "quoteSanskrit": "मङ्गल भवन अमङ्गल हारी, द्रबहु सुदशरथ अजिर बिहारी",
      "quoteEnglish": "Mangal Bhavan Amangal Hari, Dravahu Sudasharath Ajir Bihari",
      "quoteHindi": "मंगल भवन अमंगल हारी, द्रवहु सुदशरथ अजिर बिहारी",
      "quoteGujarati": "મંગલ ભવન અમંગલ હારી, દ્રવહુ સુદશરથ અજિર બિહારી",
      "meaningEnglish": "May the abode of eternal bliss and destroyer of obstacles bless all devotees with peace and prosperity.",
      "meaningHindi": "समस्त कल्याणों के धाम और कष्टों को दूर करने वाले प्रभु सभी पर कृपा प्रदान करें।",
      "meaningGujarati": "સર્વ કલ્યાણના ધામ અને વિઘ્નોના હરનારા પ્રભુ સર્વે પર કૃપા વરસાવે.",
      "author": "Ramayana"
    },
    {
      "id": "q_2",
      "quoteSanskrit": "वक्रतुण्ड महाकाय सूर्यकोटि समप्रभ।\nनिर्विघ्नं कुरु मे देव सर्वकार्येषु सर्वदा॥",
      "quoteEnglish": "O Lord with the curved trunk and immense body, radiating with the brilliance of ten million suns, please make all my endeavors free of obstacles always.",
      "quoteHindi": "घुमावदार सूंड वाले, विशाल शरीर वाले, करोड़ सूर्यों के समान तेजस्वी प्रभु! मेरे सभी कार्यों को सदा बाधारहित करें।",
      "quoteGujarati": "વાંકી સૂંઢવાળા, મહાકાય, કરોડો સૂર્ય સમાન તેજસ્વી હે દેવ! મારા સર્વ કાર્યોને સદા નિર્વિઘ્ન કરો.",
      "meaningEnglish": "A powerful prayer asking Lord Ganesha for divine wisdom and removing all life obstacles.",
      "meaningHindi": "भगवान गणेश जी से जीवन के सभी कष्ट व विघ्न दूर करने की परम पावन प्रार्थना।",
      "meaningGujarati": "ભગવાન ગણેશજી પાસે તમામ વિઘ્નો દૂર કરવાની પવિત્ર પ્રાર્થના.",
      "author": "Ganesh Purana"
    },
    {
      "id": "q_3",
      "quoteSanskrit": "एकदन्ताय विद्महे वक्रतुण्डाय धीमहि।\nतन्नो दन्तिः प्रचोदयात्॥",
      "quoteEnglish": "We meditate upon the Single-Tusked Lord, the one with curved trunk. May Lord Ganesha enlighten our mind and intellect.",
      "quoteHindi": "हम एकदन्त भगवान श्री गणेश का ध्यान करते हैं। वे हमारी बुद्धि को धर्म और प्रकाश की ओर प्रेरित करें।",
      "quoteGujarati": "અમે એકદંત શ્રી ગણેશજીનું ધ્યાન ધરીએ છીએ. તેઓ આપણી બુદ્ધિને સન્માર્ગે પ્રેરિત કરે.",
      "meaningEnglish": "Sacred Ganesh Gayatri Mantra for enhanced clarity, focus, and divine intellect.",
